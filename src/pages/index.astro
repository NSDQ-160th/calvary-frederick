---
import ConnectBand from '../components/ConnectBand.astro';
import Hero from '../components/Hero.astro';
import HomeExtras from '../components/HomeExtras.astro';
import MinistryGrid from '../components/MinistryGrid.astro';
import SermonCard from '../components/SermonCard.astro';
import ServiceTimesCard from '../components/ServiceTimesCard.astro';
import Base from '../layouts/Base.astro';
import { faqJsonLd } from '../data/schema';
import { siteFaqs } from '../data/faq';

const description =
  'Calvary Chapel Frederick is a Bible-teaching church in downtown Frederick, MD. Sunday 9:00 & 11:00 AM, Wednesday 7:00 PM. Verse-by-verse teaching. Plan a visit.';
---

<Base
  title="Calvary Chapel Frederick | Church in Downtown Frederick, MD"
  description={description}
  current="home"
  jsonLd={faqJsonLd(siteFaqs)}
>
  <Hero />
  <ServiceTimesCard />
  <ConnectBand />
  <MinistryGrid />
  <SermonCard />
  <HomeExtras />
</Base>
