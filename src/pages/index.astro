---
import AppStrip from '../components/AppStrip.astro';
import BulletinCard from '../components/BulletinCard.astro';
import GiveTeaser from '../components/GiveTeaser.astro';
import Hero from '../components/Hero.astro';
import NextSteps from '../components/NextSteps.astro';
import SermonCard from '../components/SermonCard.astro';
import ServiceTimesCard from '../components/ServiceTimesCard.astro';
import VisitTeaser from '../components/VisitTeaser.astro';
import WordRadio from '../components/WordRadio.astro';
import Base from '../layouts/Base.astro';
import { church } from '../data/church';

const description =
  'Calvary Chapel Frederick teaches the Bible verse by verse in downtown Frederick, MD. Sunday 9 & 11 AM, Wednesday 7 PM. Children’s ministry on Sunday and Wednesday.';
---

<Base title={church.name} description={description} current="home">
  <Hero />
  <ServiceTimesCard />
  <NextSteps />
  <VisitTeaser />
  <SermonCard />
  <BulletinCard />
  <WordRadio />
  <GiveTeaser />
  <AppStrip />
</Base>
