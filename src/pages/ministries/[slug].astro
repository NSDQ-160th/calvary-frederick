---
import MinistryGrid from '../../components/MinistryGrid.astro';
import VideoFrame from '../../components/VideoFrame.astro';
import Base from '../../layouts/Base.astro';
import { church } from '../../data/church';
import { ministries, ministryBySlug, otherMinistries } from '../../data/ministries';
import { breadcrumbJsonLd } from '../../data/schema';

export function getStaticPaths() {
  return ministries.map((item) => ({ params: { slug: item.slug } }));
}

const { slug } = Astro.params;
const ministry = ministryBySlug(slug ?? '');
if (!ministry) {
  throw new Error(`Unknown ministry: ${slug}`);
}

const others = otherMinistries(ministry.slug);
const title = `${ministry.title} — Calvary Chapel Frederick`;
---

<Base
  title={title}
  description={ministry.description}
  current="ministries"
  jsonLd={breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Ministries', path: '/ministries' },
    { name: ministry.title, path: `/ministries/${ministry.slug}` },
  ])}
>
  <header class="min-hero" data-hero>
    <div class="wrap min-hero__copy">
      <p class="meta">Ministries</p>
      <h1>{ministry.title}</h1>
      <p class="lead">{ministry.lead}</p>
    </div>
  </header>

  <div class="min-hero__frame wrap">
    <VideoFrame src={ministry.video} poster={ministry.poster} label={`${ministry.title} at ${church.name}`} />
  </div>

  <article class="body wrap">
    <p class="scripture">
      {ministry.scripture.text}
      <cite> — {ministry.scripture.ref}</cite>
    </p>
    {ministry.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    <dl class="facts">
      {
        ministry.facts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>{fact.value}</dd>
          </div>
        ))
      }
    </dl>
    <p class="cta">
      <a class="btn btn--primary" href={`mailto:${ministry.email}`}>Email {ministry.title.toLowerCase()}</a>
      <a class="btn btn--secondary" href="/visit#plan">Plan a visit</a>
    </p>
  </article>

  {
    others.length > 0 && (
      <MinistryGrid heading="More ministries" id={`${ministry.slug}-more`} exclude={ministry.slug} />
    )
  }
</Base>

<style>
  .min-hero {
    background: var(--forest-deep);
    color: var(--cream);
    padding: 7.25rem 0 5rem;
  }

  .min-hero__copy {
    max-width: 36rem;
  }

  .min-hero .meta {
    margin-bottom: var(--space-3);
    color: var(--inverse-muted);
  }

  .min-hero h1 {
    margin-bottom: var(--space-4);
    font-size: clamp(2.1rem, 5vw, 3.15rem);
    line-height: 1.16;
    letter-spacing: 0.1em;
  }

  .min-hero .lead {
    letter-spacing: 0;
    text-transform: none;
    font-family: var(--font-ui);
    color: var(--inverse);
    max-width: 32rem;
  }

  .min-hero__frame {
    width: min(58rem, calc(100% - (var(--page-margin) * 2)));
    margin: -3rem auto var(--space-12);
    position: relative;
    z-index: 1;
  }

  .body {
    padding-bottom: var(--space-16);
    max-width: 40rem;
  }

  .body p + p {
    margin-top: var(--space-5);
  }

  .body .scripture {
    margin-bottom: var(--space-8);
  }

  .scripture cite {
    font-style: italic;
    font-family: var(--font-scripture);
  }

  .facts {
    margin: var(--space-10) 0;
    display: grid;
    gap: var(--space-5);
  }

  .facts dt {
    font-family: var(--font-display);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--ink-soft);
    margin-bottom: 0.25rem;
  }

  .facts dd {
    margin: 0;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-10);
  }

  @media (min-width: 768px) {
    .min-hero__frame {
      margin-top: -3.75rem;
    }
  }
</style>
