---
import MinistryGrid from '../../components/MinistryGrid.astro';
import PageHero from '../../components/PageHero.astro';
import Base from '../../layouts/Base.astro';
import { church } from '../../data/church';
import { breadcrumbJsonLd } from '../../data/schema';

const title = 'Ministries — Calvary Chapel Frederick';
const description = `Ministries at Calvary Chapel Frederick: preschool, children, students, young adults, women, men, small groups, volunteer, School of Ministry, SonShine LC, and discipleship. Downtown Frederick, MD.`;
---

<Base
  title={title}
  description={description}
  current="ministries"
  jsonLd={breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Ministries', path: '/ministries' },
  ])}
>
  <PageHero
    eyebrow={church.name}
    title="Ministries"
    lead="Something for everyone — kids, students, groups, School of Ministry, SonShine LC, discipleship, and a place to serve."
    image="/images/ministries/groups.jpg"
  />
  <MinistryGrid heading="Something for everyone" id="everyone-heading" />
</Base>
