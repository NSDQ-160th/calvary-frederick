---
import BeliefAccordion from '../components/BeliefAccordion.astro';
import FaqList from '../components/FaqList.astro';
import MinistryGrid from '../components/MinistryGrid.astro';
import PageHero from '../components/PageHero.astro';
import PlanVisitForm from '../components/PlanVisitForm.astro';
import GatheringLook from '../components/GatheringLook.astro';
import Base from '../layouts/Base.astro';
import { church, formatPhone, formatServiceTime, mapsUrl, telHref } from '../data/church';
import { visitFaqs } from '../data/faq';
import { breadcrumbJsonLd, faqJsonLd } from '../data/schema';

const sunday = church.services.sunday.map(formatServiceTime).join(' & ');
const wednesday = formatServiceTime(church.services.wednesday);
const title = `Plan a Visit — Calvary Chapel Frederick | Sunday 9 & 11, Downtown Frederick, MD`;
const description = `Visit Calvary Chapel Frederick at 244A S Jefferson St in downtown Frederick, MD. Sunday ${sunday}, Wednesday ${wednesday}. Children’s ministry and verse-by-verse Bible teaching. Plan your visit.`;
---

<Base
  title={title}
  description={description}
  current="visit"
  jsonLd={[
    breadcrumbJsonLd([
      { name: 'Home', path: '/' },
      { name: 'Plan a Visit', path: '/visit' },
    ]),
    faqJsonLd(visitFaqs),
  ]}
>
  <PageHero
    eyebrow="Welcome"
    title="Plan Your Visit"
    lead="A Calvary Chapel in downtown Frederick, Maryland. Come any Sunday or Wednesday — we would love to meet you."
  />

  <nav class="sub" aria-label="On this page">
    <div class="wrap sub__row">
      <a href="#plan">Plan</a>
      <a href="#expect">Expect</a>
      <a href="#kids">Kids</a>
      <a href="#ministries">Ministries</a>
      <a href="#believe">Believe</a>
      <a href="#faq">Questions</a>
    </div>
  </nav>

  <section class="intro" aria-labelledby="intro-heading">
    <div class="wrap intro__grid">
      <div>
        <p class="meta">New here?</p>
        <h2 id="intro-heading">We saved you a seat</h2>
        <p>
          Please feel welcome to join us any time. If you have a Bible you can bring it; if not,
          we have extras. Services begin with prayer and worship, then the Word taught verse by
          verse.
        </p>
        <p class="intro__times">
          <strong>Sunday</strong> {sunday}<br />
          <strong>Wednesday</strong> {formatServiceTime(church.services.fellowshipDinner.time)}{' '}
          fellowship dinner, then {wednesday} Bible study<br />
          <strong>Prayer</strong> {church.services.middayPrayer.days}
          {' '}
          {formatServiceTime(church.services.middayPrayer.start)}–{formatServiceTime(church.services.middayPrayer.end)}
          <br />
          <strong>Kids</strong> Sunday {church.services.kidsSunday}; Wednesday children’s church{' '}
          {church.services.kidsWednesday}.
        </p>
        <p>
          <a class="btn btn--primary" href={mapsUrl()} target="_blank" rel="noreferrer">Get directions</a>
        </p>
        <p class="intro__nap">
          {church.address.line}, {church.address.city}, {church.address.region} {church.address.postal}
          · <a href={telHref()}>{formatPhone()}</a>
        </p>
      </div>
      <PlanVisitForm />
    </div>
  </section>

  <div id="expect">
    <GatheringLook gathering="sunday" />
    <GatheringLook gathering="wednesday" />
  </div>

  <section class="kids" id="kids" aria-labelledby="kids-heading">
    <div class="wrap kids__grid">
      <img src="/images/ministries/children.jpg" alt="" width="1400" height="933" />
      <div>
        <p class="meta">Kids & youth</p>
        <h2 id="kids-heading">A place for your children</h2>
        <p>
          Sunday: {church.services.kidsSunday}. Wednesday children’s church {church.services.kidsWednesday}.
          We teach the Bible with crafts and games at their age.
          {' '}
          <a href="/ministries/preschool">Preschool</a>
          {' · '}
          <a href="/ministries/children">Children</a>
        </p>
        <p>
          Middle school meets Sunday at 9:00 AM in the youth room. High school joins the main
          service. Midweek, middle and high school meet together for Ignite.
          {' '}
          <a href="/ministries/students">Students</a>
        </p>
      </div>
    </div>
  </section>

  <div id="ministries">
    <MinistryGrid heading="Something for everyone" id="ministries-heading" />
  </div>

  <section class="gospel" id="gospel" aria-labelledby="gospel-heading">
    <div class="wrap gospel__narrow">
      <p class="meta">Know God</p>
      <h2 id="gospel-heading">The best gift</h2>
      <p>
        God so loved the world that He gave His only Son. You are welcome here whether you have
        walked with Jesus for years or you are still asking questions.
      </p>
    </div>
  </section>

  <section class="prayer" id="prayer" aria-labelledby="prayer-heading">
    <div class="wrap gospel__narrow">
      <p class="meta">Prayer & care</p>
      <h2 id="prayer-heading">We will pray with you</h2>
      <p>
        Call <a href={telHref()}>{formatPhone()}</a> or email
        <a href={`mailto:${church.email}`}>{church.email}</a>. Care for those in need is
        coordinated through the church office.
      </p>
    </div>
  </section>

  <section class="faith" id="believe" aria-labelledby="believe-heading">
    <div class="wrap gospel__narrow">
      <p class="meta" id="faith">What we believe</p>
      <h2 id="believe-heading">Statement of faith</h2>
      <p>
        Pastor {church.pastor.name} came to faith at the U.S. Naval Academy, later served at
        Cornerstone Chapel in Leesburg, and began teaching in Frederick in 2006.
      </p>
      <div id="more">
        <BeliefAccordion />
      </div>
    </div>
  </section>

  <FaqList items={visitFaqs} />
</Base>

<style>
  .sub {
    position: sticky;
    top: 5.25rem;
    z-index: 30;
    background: var(--cream);
    border-bottom: 1px solid var(--rule);
  }

  .sub__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
  }

  .sub a {
    font-family: var(--font-display);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: 0.8rem;
    text-decoration: none;
    color: var(--forest-deep);
    min-height: 48px;
    display: inline-flex;
    align-items: center;
  }

  .intro {
    padding: var(--space-14) 0;
  }

  .intro__grid {
    display: grid;
    gap: var(--space-10);
    align-items: start;
  }

  .intro .meta {
    margin-bottom: var(--space-3);
    color: var(--ink-soft);
  }

  .intro h2 {
    margin-bottom: var(--space-4);
  }

  .intro__times {
    margin: var(--space-6) 0;
    line-height: 1.8;
  }

  .intro__nap {
    margin-top: var(--space-4);
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .band {
    background: var(--paper);
    padding: var(--space-14) 0;
  }

  .band .meta,
  .kids .meta,
  .gospel .meta,
  .prayer .meta,
  .faith .meta {
    margin-bottom: var(--space-3);
    color: var(--ink-soft);
  }

  .kids {
    padding: var(--space-14) 0;
  }

  .kids__grid {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  .kids img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border: 8px solid var(--cream);
    box-shadow:
      0 0 0 1px var(--gold),
      0 18px 40px rgb(10 48 64 / 0.12);
  }

  .gospel,
  .prayer,
  .faith {
    padding: var(--space-12) 0;
  }

  .gospel {
    background: var(--forest-deep);
    color: var(--cream);
  }

  .gospel .meta {
    color: var(--inverse-muted);
  }

  .gospel__narrow {
    max-width: 42rem;
  }

  .prayer a,
  .kids a,
  .intro a:not(.btn) {
    color: var(--forest-deep);
  }

  .gospel a {
    color: var(--cream);
  }

  @media (min-width: 900px) {
    .intro__grid,
    .kids__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-16);
    }
  }
</style>
