---
import PageHero from '../components/PageHero.astro';
import PodcastLinks from '../components/PodcastLinks.astro';
import SubsplashEmbed from '../components/SubsplashEmbed.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/icons';
import Base from '../layouts/Base.astro';
import { church, collectionUrl } from '../data/church';
import { breadcrumbJsonLd } from '../data/schema';

const latest = church.sermon.title.trim() || 'Latest Sunday message';

const collections: { id: string; label: string; text: string; icon: IconName }[] = [
  { id: church.media.sunday, label: 'Sunday', text: 'Weekend messages', icon: 'play' },
  { id: church.media.midweek, label: 'Midweek', text: 'Wednesday study', icon: 'book' },
  { id: church.media.archive, label: 'Archive', text: 'Verse by verse', icon: 'book' },
  { id: church.media.radio, label: 'Radio', text: 'Truth with Grace', icon: 'headphones' },
];

const title = `Watch Sermons — Calvary Chapel Frederick | Verse by Verse`;
const description =
  'Watch Calvary Chapel Frederick teach the Bible verse by verse. Sunday, Wednesday, archive, and Truth with Grace. Pastor David Ochoa. Frederick, MD.';
---

<Base
  title={title}
  description={description}
  current="watch"
  jsonLd={[
    breadcrumbJsonLd([
      { name: 'Home', path: '/' },
      { name: 'Watch', path: '/watch' },
    ]),
    {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'Watch — Calvary Chapel Frederick',
      description,
      url: 'https://www.calvaryfrederick.com/watch/',
      isPartOf: { '@id': 'https://www.calvaryfrederick.com/#church' },
    },
  ]}
>
  <PageHero
    eyebrow="Teachings"
    title="Watch"
    lead="Sunday, midweek, and the archive — the Word taught verse by verse."
    image="/images/ministries/prayer.jpg"
  />

  <section class="player" aria-labelledby="player-heading">
    <div class="wrap player__inner">
      <p class="meta">{church.sermon.series}</p>
      <h2 id="player-heading">{latest}</h2>
      <p class="player__by">{church.sermon.speaker}</p>
      <SubsplashEmbed path={church.media.messagesEmbed} />
      <p class="caption-help">Turn on captions in the player.</p>
    </div>
  </section>

  <section class="collections wrap" aria-labelledby="collections-heading">
    <p class="meta">Browse</p>
    <h2 id="collections-heading">More teaching</h2>
    <ul>
      {
        collections.map((item) => (
          <li>
            <a href={collectionUrl(item.id)} target="_blank" rel="noreferrer">
              <span class="collections__icon">
                <Icon name={item.icon} />
              </span>
              <span class="collections__label">{item.label}</span>
              <span class="collections__text">{item.text}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="listen" id="app" aria-labelledby="listen-heading">
    <div class="wrap listen__grid">
      <div>
        <p class="meta">Listen</p>
        <h2 id="listen-heading">Take the Word with you</h2>
        <p>
          Watch live on
          <a href={church.media.youtube} target="_blank" rel="noreferrer">YouTube</a>
          or in the
          <a href={church.media.app} target="_blank" rel="noreferrer">church app</a>.
        </p>
      </div>
      <PodcastLinks />
    </div>
  </section>
</Base>

<style>
  .player {
    background: var(--forest-deep);
    color: var(--cream);
    padding: var(--space-16) 0;
  }

  .player__inner {
    max-width: 64rem;
  }

  .player .meta {
    margin-bottom: var(--space-3);
    color: rgb(246 241 232 / 0.7);
  }

  .player h2 {
    margin-bottom: var(--space-2);
  }

  .player__by {
    margin-bottom: var(--space-8);
    font-family: var(--font-ui);
    letter-spacing: 0;
    text-transform: none;
    color: rgb(246 241 232 / 0.8);
  }

  .caption-help {
    margin-top: var(--space-4);
    color: rgb(246 241 232 / 0.7);
    font-size: var(--step--1);
  }

  .player :global(.embed__fallback a) {
    color: var(--cream);
  }

  .collections {
    padding: var(--space-16) 0;
    text-align: center;
  }

  .collections .meta {
    margin-bottom: var(--space-3);
    color: var(--ink-soft);
  }

  .collections h2 {
    margin-bottom: var(--space-10);
  }

  .collections ul {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  .collections a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    min-height: 200px;
    padding: var(--space-8) var(--space-4);
    text-decoration: none;
    color: var(--forest-deep);
    border: 1px solid var(--rule);
    background: var(--paper);
    transition: border-color var(--duration-enter) var(--ease-enter),
      background-color var(--duration-enter) var(--ease-enter);
  }

  .collections a:hover,
  .collections a:focus-visible {
    border-color: var(--forest);
    background: var(--cream);
  }

  .collections__icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border: 1.5px solid var(--forest);
    color: var(--forest);
  }

  .collections__label {
    font-family: var(--font-display);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: 1.1rem;
  }

  .collections__text {
    font-family: var(--font-ui);
    letter-spacing: 0;
    text-transform: none;
    color: var(--ink-soft);
  }

  .listen {
    background: var(--paper);
    padding: var(--space-16) 0;
  }

  .listen__grid {
    display: grid;
    gap: var(--space-10);
    align-items: start;
  }

  .listen .meta {
    margin-bottom: var(--space-3);
    color: var(--ink-soft);
  }

  .listen h2 {
    margin-bottom: var(--space-4);
  }

  .listen p {
    max-width: 32rem;
  }

  .listen a {
    color: var(--forest-deep);
    font-weight: 600;
  }

  @media (min-width: 768px) {
    .collections ul {
      grid-template-columns: repeat(4, 1fr);
    }

    .listen__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-16);
    }
  }
</style>
