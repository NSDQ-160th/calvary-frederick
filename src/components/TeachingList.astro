---
import type { Teaching } from '../data/media';
import { snapTeachingUrl } from '../data/media';

interface Props {
  teachings: Teaching[];
  more?: boolean;
  moreHref?: string;
}

const { teachings, more = false, moreHref } = Astro.props;
---

<ol class="list">
  {
    teachings.map((item) => (
      <li>
        <a href={snapTeachingUrl(item)} target="_blank" rel="noreferrer">
          <span class="list__title">{item.title}</span>
          <span class="list__meta">
            {item.date}
            {item.speaker ? ` · ${item.speaker}` : ''}
          </span>
        </a>
      </li>
    ))
  }
</ol>
{
  more && moreHref && (
    <p class="list__more">
      <a href={moreHref} target="_blank" rel="noreferrer">
        More teachings in this series
      </a>
    </p>
  )
}

<style>
  .list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--rule);
  }

  a {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: inherit;
    min-height: 48px;
  }

  a:hover .list__title,
  a:focus-visible .list__title {
    color: var(--forest);
  }

  .list__title {
    font-family: var(--font-ui);
    font-weight: 600;
    letter-spacing: 0;
    text-transform: none;
    font-size: 1.05rem;
    line-height: 1.4;
  }

  .list__meta {
    color: var(--ink-soft);
    font-size: var(--step--1);
  }

  .list__more {
    margin-top: var(--space-6);
  }

  .list__more a {
    color: var(--forest-deep);
    font-weight: 600;
    border: 0;
    padding: 0;
  }
</style>
