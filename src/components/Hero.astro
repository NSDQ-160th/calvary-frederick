---
import { church } from '../data/church';
---

<section class="hero" data-hero>
  <div class="hero__media" aria-hidden="true">
    <img
      src="/images/hero-frederick.jpg"
      alt=""
      width="2000"
      height="1500"
      fetchpriority="high"
    />
  </div>
  <div class="hero__inner wrap">
    <p class="meta">{church.name}</p>
    <h1>{church.tagline}</h1>
    <p class="lead">A Calvary Chapel in downtown Frederick.</p>
    <p class="hero__cta">
      <a class="btn btn--primary btn--xl" href="/visit#plan">Plan Your Visit</a>
    </p>
  </div>
  <a class="hero__scroll" href="#location" aria-label="Scroll to location and services">
    <span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--cream);
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .hero__media img {
    width: 112%;
    height: 112%;
    object-fit: cover;
    object-position: center 40%;
    animation: ken 28s var(--ease-enter) infinite alternate;
  }

  .hero__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(28 26 23 / 0.35) 0%, rgb(42 67 51 / 0.45) 45%, rgb(28 26 23 / 0.72) 100%);
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 8rem 0 6rem;
  }

  .meta {
    margin-bottom: var(--space-5);
    color: rgb(246 241 232 / 0.82);
  }

  h1 {
    max-width: 16ch;
    margin: 0 auto var(--space-5);
    font-size: clamp(2.4rem, 6vw, 4.6rem);
    line-height: 1.12;
  }

  .lead {
    max-width: 26rem;
    margin: 0 auto var(--space-8);
    letter-spacing: 0;
    text-transform: none;
    font-family: var(--font-ui);
    color: rgb(246 241 232 / 0.92);
  }

  .hero :global(.btn--primary) {
    background: var(--cream);
    color: var(--forest-deep);
    border-color: var(--cream);
  }

  .hero :global(.btn--primary:hover),
  .hero :global(.btn--primary:focus-visible) {
    background: transparent;
    color: var(--cream);
    border-color: var(--cream);
  }

  .hero__scroll {
    position: absolute;
    bottom: 1.6rem;
    left: 50%;
    z-index: 1;
    width: 28px;
    height: 44px;
    transform: translateX(-50%);
  }

  .hero__scroll span {
    display: block;
    width: 14px;
    height: 14px;
    margin: 8px auto 0;
    border-right: 1.5px solid var(--cream);
    border-bottom: 1.5px solid var(--cream);
    transform: rotate(45deg);
    animation: bounce 1.8s var(--ease-enter) infinite;
  }

  @keyframes ken {
    from {
      transform: scale(1) translate(0, 0);
    }
    to {
      transform: scale(1.08) translate(-3%, -2%);
    }
  }

  @keyframes bounce {
    0%,
    100% {
      transform: translateY(0) rotate(45deg);
      opacity: 0.4;
    }
    50% {
      transform: translateY(8px) rotate(45deg);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__media img,
    .hero__scroll span {
      animation: none;
    }
  }
</style>
