---
import { church } from '../data/church';

const videoSrc = church.hero.video.trim();
const poster = church.hero.poster;
---

<section class="hero" data-hero>
  <div class="hero__media" aria-hidden="true">
    {
      videoSrc ? (
        <video
          class="hero__video"
          data-hero-video
          poster={poster}
          muted
          loop
          playsinline
          autoplay
          preload="metadata"
        >
          <source src={videoSrc} type="video/mp4" />
        </video>
      ) : null
    }
    <img
      class:list={['hero__poster', { 'hero__poster--only': !videoSrc }]}
      src={poster}
      alt=""
      width="2000"
      height="1500"
      fetchpriority="high"
    />
  </div>
  <div class="hero__inner wrap">
    <p class="meta">{church.name}</p>
    <h1>{church.tagline}</h1>
    <p class="lead">A Calvary Chapel in downtown Frederick.</p>
    <p class="hero__cta">
      <a class="btn btn--primary btn--xl" href="/visit#plan">Plan Your Visit</a>
    </p>
  </div>
  <a class="hero__scroll" href="#location" aria-label="Scroll to location and services">
    <span></span>
  </a>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (video) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const apply = () => {
      if (reduce.matches) {
        video.pause();
        video.classList.add('is-paused');
      } else {
        video.classList.remove('is-paused');
        void video.play().catch(() => {
          /* autoplay blocked — poster remains visible */
        });
      }
    };
    apply();
    reduce.addEventListener('change', apply);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) video.pause();
      else apply();
    });
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--cream);
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--forest-deep);
  }

  .hero__video,
  .hero__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .hero__video {
    z-index: 1;
  }

  .hero__video.is-paused {
    visibility: hidden;
  }

  .hero__poster {
    z-index: 0;
  }

  .hero__media::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    background:
      linear-gradient(180deg, rgb(28 26 23 / 0.35) 0%, rgb(42 67 51 / 0.45) 45%, rgb(28 26 23 / 0.72) 100%);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    z-index: 3;
    text-align: center;
    padding: 8rem 0 6rem;
  }

  .meta {
    margin-bottom: var(--space-5);
    color: rgb(246 241 232 / 0.82);
  }

  h1 {
    max-width: 16ch;
    margin: 0 auto var(--space-5);
    font-size: clamp(2.4rem, 6vw, 4.6rem);
    line-height: 1.12;
  }

  .lead {
    max-width: 26rem;
    margin: 0 auto var(--space-8);
    letter-spacing: 0;
    text-transform: none;
    font-family: var(--font-ui);
    color: rgb(246 241 232 / 0.92);
  }

  .hero :global(.btn--primary) {
    background: var(--cream);
    color: var(--forest-deep);
    border-color: var(--cream);
  }

  .hero :global(.btn--primary:hover),
  .hero :global(.btn--primary:focus-visible) {
    background: transparent;
    color: var(--cream);
    border-color: var(--cream);
  }

  .hero__scroll {
    position: absolute;
    bottom: 1.6rem;
    left: 50%;
    z-index: 3;
    width: 28px;
    height: 44px;
    transform: translateX(-50%);
  }

  .hero__scroll span {
    display: block;
    width: 14px;
    height: 14px;
    margin: 8px auto 0;
    border-right: 1.5px solid var(--cream);
    border-bottom: 1.5px solid var(--cream);
    transform: rotate(45deg);
    animation: bounce 1.8s var(--ease-enter) infinite;
  }

  @keyframes bounce {
    0%,
    100% {
      transform: translateY(0) rotate(45deg);
      opacity: 0.4;
    }
    50% {
      transform: translateY(8px) rotate(45deg);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__video {
      visibility: hidden;
    }

    .hero__scroll span {
      animation: none;
    }
  }
</style>
