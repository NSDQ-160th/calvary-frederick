---
import { church } from '../data/church';

interface Props {
  inverse?: boolean;
  compact?: boolean;
}

const { inverse = false, compact = false } = Astro.props;
const label = church.name;
---

<a class:list={['logo', { 'logo--inverse': inverse, 'logo--compact': compact }]} href="/" aria-label={label}>
  <span class="logo__mark">
    <img src="/images/dove.png" alt="" width="56" height="56" />
  </span>
  {
    !compact && (
      <span class="logo__word">
        <span class="logo__line">Calvary Chapel</span>
        <span class="logo__place">Frederick</span>
      </span>
    )
  }
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    text-decoration: none;
    color: inherit;
    min-height: 44px;
  }

  .logo__mark {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 8px;
    overflow: hidden;
    background: var(--forest);
    box-shadow: inset 0 0 0 2px var(--cream);
    flex-shrink: 0;
  }

  .logo__mark img {
    width: 56px;
    height: 56px;
    object-fit: cover;
    mix-blend-mode: screen;
  }

  .logo__word {
    display: flex;
    flex-direction: column;
    line-height: 1.05;
  }

  .logo__line {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .logo__place {
    font-family: var(--font-ui);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: none;
  }

  .logo--inverse .logo__mark {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--cream);
  }

  .logo--compact .logo__mark {
    width: 48px;
    height: 48px;
  }
</style>
