---
interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  image?: string;
}

const { eyebrow, title, lead, image = '/images/hero-frederick.jpg' } = Astro.props;
---

<header class="page-hero" data-hero>
  <div class="page-hero__media" aria-hidden="true">
    <img src={image} alt="" width="2000" height="1500" />
  </div>
  <div class="page-hero__inner wrap">
    {eyebrow && <p class="meta">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</header>

<style>
  .page-hero {
    position: relative;
    min-height: 38vh;
    display: flex;
    align-items: flex-end;
    color: var(--cream);
    overflow: hidden;
  }

  .page-hero__media {
    position: absolute;
    inset: 0;
  }

  .page-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .page-hero__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(10 48 64 / 0.25), rgb(10 48 64 / 0.72));
  }

  .page-hero__inner {
    position: relative;
    z-index: 1;
    padding: 7.25rem 0 2.75rem;
  }

  .meta {
    margin-bottom: var(--space-3);
    color: var(--inverse-muted);
  }

  h1 {
    margin-bottom: 0;
    font-size: clamp(2rem, 4.8vw, 3.15rem);
    line-height: 1.16;
    letter-spacing: 0.1em;
    max-width: 18ch;
  }

  .lead {
    margin-top: var(--space-4);
    max-width: 36rem;
    letter-spacing: 0;
    text-transform: none;
    font-family: var(--font-ui);
  }
</style>
