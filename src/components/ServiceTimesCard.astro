---
import { church, formatServiceTime, mapsUrl } from '../data/church';

const sunday = church.services.sunday.map(formatServiceTime).join(' & ');
const wednesday = formatServiceTime(church.services.wednesday);
const calendars = [
  { href: '/calendar/sunday-9am.ics', label: 'Sunday 9:00 AM' },
  { href: '/calendar/sunday-11am.ics', label: 'Sunday 11:00 AM' },
  { href: '/calendar/wednesday-7pm.ics', label: 'Wednesday 7:00 PM' },
];
---

<section class="location" id="location" aria-labelledby="location-heading">
  <div class="wrap">
    <p class="meta">Join us</p>
    <h2 id="location-heading">Location & Services</h2>
    <div class="location__grid">
      <div>
        <h3 class="meta">Location</h3>
        <p>
          {church.name}<br />
          {church.address.line}<br />
          {church.address.city}, {church.address.region} {church.address.postal}
        </p>
        <p>
          <a class="btn btn--secondary" href={mapsUrl()} target="_blank" rel="noreferrer">Get directions</a>
        </p>
      </div>
      <div>
        <h3 class="meta">Service times</h3>
        <p>Sunday {sunday}</p>
        <p>Wednesday {wednesday}</p>
        <p>
          Prayer {church.services.middayPrayer.days}
          {' '}
          {formatServiceTime(church.services.middayPrayer.start)}–{formatServiceTime(church.services.middayPrayer.end)}
        </p>
        <p class="location__kids">
          Kids: Sunday {church.services.kidsSunday}; Wednesday children’s church {church.services.kidsWednesday}.
        </p>
        <p class="location__cal-label meta">Add to calendar</p>
        <p class="location__cal">
          {calendars.map((item) => <a href={item.href}>{item.label}</a>)}
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .location {
    background: var(--paper);
    padding: var(--space-16) 0;
    text-align: center;
  }

  .meta {
    margin-bottom: var(--space-3);
    color: var(--ink-soft);
  }

  h2 {
    margin-bottom: var(--space-12);
  }

  .location__grid {
    display: grid;
    gap: var(--space-12);
    text-align: left;
    max-width: 52rem;
    margin: 0 auto;
  }

  h3 {
    margin-bottom: var(--space-4);
    color: var(--ink-soft);
  }

  p + p {
    margin-top: var(--space-3);
  }

  .location__kids {
    color: var(--ink-soft);
    font-size: var(--step--1);
    line-height: var(--step--1-lh);
  }

  .location__cal-label {
    margin-top: var(--space-6);
  }

  .location__cal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .location__cal a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.85rem;
    border: 1.5px solid var(--forest);
    color: var(--forest);
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .location__cal a:hover,
  .location__cal a:focus-visible {
    background: var(--forest);
    color: var(--cream);
  }

  @media (min-width: 768px) {
    .location__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-16);
    }
  }
</style>
