---
import { church, formatServiceTime, mapsUrl } from '../data/church';
import Icon from './Icon.astro';

const sunday = church.services.sunday.map(formatServiceTime).join(' & ');
const wednesday = formatServiceTime(church.services.wednesday);
const calendars = [
  { href: '/calendar/sunday-9am.ics', label: 'Sunday 9:00 AM' },
  { href: '/calendar/sunday-11am.ics', label: 'Sunday 11:00 AM' },
  { href: '/calendar/wednesday-7pm.ics', label: 'Wednesday 7:00 PM' },
];
---

<section class="times wrap" aria-labelledby="times-heading">
  <div class="times__card">
    <h2 id="times-heading" class="meta">Join us</h2>
    <ul>
      <li>
        <Icon name="clock" />
        <div>
          <p>Sunday {sunday}</p>
          <p class="times__sub">Wednesday {wednesday}</p>
        </div>
      </li>
      <li>
        <Icon name="child" />
        <p>
          Kids: Sunday {church.services.kidsSunday}; Wednesday children’s church {church.services.kidsWednesday}.
        </p>
      </li>
      <li>
        <Icon name="pin" />
        <p>
          <a href={mapsUrl()} target="_blank" rel="noreferrer">
            {church.address.line}, {church.address.city}, {church.address.region} {church.address.postal}
          </a>
          <span class="times__sub">Get directions</span>
        </p>
      </li>
    </ul>
    <p class="meta times__cal-label">Add to calendar</p>
    <p class="times__cal">
      {
        calendars.map((item) => (
          <a href={item.href}>{item.label}</a>
        ))
      }
    </p>
  </div>
</section>

<style>
  .times {
    position: relative;
    z-index: 2;
    margin-top: -3rem;
  }

  .times__card {
    background: var(--paper);
    color: var(--ink);
    padding: var(--space-8);
    box-shadow: 0 16px 40px rgb(28 26 23 / 0.08);
    border: 1px solid var(--rule);
  }

  h2 {
    margin-bottom: var(--space-6);
    color: var(--ink-soft);
  }

  ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  li {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .times__sub {
    display: block;
    color: var(--ink-soft);
    font-size: var(--step--1);
    line-height: var(--step--1-lh);
    margin-top: 0.15rem;
  }

  a {
    color: var(--forest-deep);
  }

  .times__cal-label {
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
    color: var(--ink-soft);
  }

  .times__cal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .times__cal a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.85rem;
    border: 1.5px solid var(--forest);
    color: var(--forest);
    text-decoration: none;
    font-weight: 600;
    font-size: var(--step--1);
  }

  .times__cal a:hover,
  .times__cal a:focus-visible {
    background: var(--forest);
    color: var(--cream);
  }

  @media (min-width: 768px) {
    ul {
      display: grid;
      grid-template-columns: 1.2fr 1fr 1fr;
      gap: var(--space-6);
    }
  }
</style>
