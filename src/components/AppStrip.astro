---
import { church } from '../data/church';
---

<section class="app wrap" id="app">
  <p class="meta">Church app</p>
  <h2>Take the Word with you</h2>
  <p>Messages, giving, and updates in the Calvary Chapel Frederick app.</p>
  <p>
    <a class="btn btn--primary" href={church.media.app} target="_blank" rel="noreferrer">
      Download the app
    </a>
  </p>
</section>

<style>
  .app {
    padding: var(--space-12) 0 var(--space-16);
    max-width: 40rem;
  }

  .meta {
    margin-bottom: var(--space-4);
    color: var(--ink-soft);
  }

  h2 {
    margin-bottom: var(--space-4);
  }

  p + p {
    margin-top: var(--space-6);
  }
</style>
