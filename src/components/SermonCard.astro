---
import Icon from './Icon.astro';
import { church } from '../data/church';
import {
  latestSeries,
  media,
  recentTeachings,
  seriesPath,
  snapTeachingUrl,
} from '../data/media';

const latest = media.latest;
const series = latestSeries();
const cover = series?.cover || church.sermon.image;
const title = latest.title.trim() || church.sermon.title;
const recent = recentTeachings(4);
---

<section class="watch" aria-labelledby="sermon-heading">
  <div class="wrap">
    <p class="meta">Watch our latest message</p>
    <div class="watch__feature">
      <a class="watch__stage" href={snapTeachingUrl(latest)} target="_blank" rel="noreferrer">
        <img src={cover} alt="" width="1600" height="900" />
        <span class="watch__play" aria-hidden="true">
          <Icon name="play" />
        </span>
      </a>
      <div class="watch__copy">
        {series && <p class="watch__series">{series.title}</p>}
        <h2 id="sermon-heading">{title}</h2>
        <p class="watch__by">
          {latest.date}
          {latest.speaker ? ` · ${latest.speaker}` : ''}
        </p>
        <p class="watch__cta">
          <a class="btn btn--primary" href={snapTeachingUrl(latest)} target="_blank" rel="noreferrer">
            Watch now
          </a>
          {series && <a class="btn btn--secondary" href={seriesPath(series)}>View series</a>}
        </p>
      </div>
    </div>
    {
      recent.length > 1 && (
        <ul class="watch__recent">
          {recent.map((item) => (
            <li>
              <a href={snapTeachingUrl(item)} target="_blank" rel="noreferrer">
                <img src={cover} alt="" width="800" height="450" />
                <span class="watch__recent-title">{item.title}</span>
                <span class="watch__recent-meta">{item.date}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .watch {
    background: var(--forest-deep);
    color: var(--cream);
    padding: var(--space-14) 0;
  }

  .meta {
    margin-bottom: var(--space-6);
    color: var(--gold-bright);
  }

  .watch__feature {
    display: grid;
    gap: var(--space-6);
  }

  .watch__stage {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--forest);
    color: var(--cream);
  }

  .watch__stage img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .watch__play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgb(10 48 64 / 0.28);
  }

  .watch__play :global(.icon) {
    width: 72px;
    height: 72px;
    padding: 1.1rem;
    border: 2px solid var(--cream);
    background: rgb(0 127 167 / 0.85);
  }

  .watch__copy h2 {
    margin-bottom: var(--space-3);
    font-size: clamp(1.8rem, 4vw, 2.75rem);
    letter-spacing: 0.08em;
  }

  .watch__series {
    margin-bottom: var(--space-3);
    font-family: var(--font-display);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-size: 0.8rem;
    color: var(--gold-bright);
  }

  .watch__by {
    color: var(--inverse-muted);
    margin-bottom: var(--space-6);
  }

  .watch__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .watch :global(.btn--primary) {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--forest-deep);
  }

  .watch :global(.btn--secondary) {
    color: var(--cream);
    border-color: var(--cream);
  }

  .watch :global(.btn--secondary:hover),
  .watch :global(.btn--secondary:focus-visible) {
    background: var(--cream);
    color: var(--forest-deep);
  }

  .watch__recent {
    list-style: none;
    padding: 0;
    margin: var(--space-10) 0 0;
    display: grid;
    gap: var(--space-4);
  }

  .watch__recent a {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    text-decoration: none;
    color: var(--cream);
  }

  .watch__recent img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--forest);
  }

  .watch__recent-title {
    font-weight: 600;
  }

  .watch__recent-meta {
    color: var(--inverse-muted);
    font-size: var(--step--1);
  }

  @media (min-width: 768px) {
    .watch__recent {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 900px) {
    .watch__feature {
      grid-template-columns: 1.65fr 1fr;
      gap: var(--space-10);
      align-items: center;
    }
  }
</style>
