---
import { church } from '../data/church';

const href = church.routes.give ? '/give' : church.giving.subsplashEmbed;
const label = church.routes.give ? 'Give' : 'Give on Subsplash';
const external = !church.routes.give;
---

<section class="give wrap">
  <p class="meta">Give</p>
  <h2>A cheerful giver</h2>
  <p>
    {church.giving.lead} {church.giving.boxes} You may also give online, or by bill-pay and check.
  </p>
  <p>
    <a
      class="btn btn--primary"
      href={href}
      target={external ? '_blank' : undefined}
      rel={external ? 'noreferrer' : undefined}
    >
      {label}
    </a>
  </p>
</section>

<style>
  .give {
    padding: var(--space-14) 0;
    max-width: 40rem;
    text-align: center;
  }

  .meta {
    margin-bottom: var(--space-4);
    color: var(--ink-soft);
  }

  h2 {
    margin-bottom: var(--space-4);
  }

  p + p {
    margin-top: var(--space-6);
  }
</style>
