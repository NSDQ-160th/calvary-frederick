---
import { church } from '../data/church';
---

<section class="week wrap" aria-labelledby="week-heading">
  <p class="meta">{church.bulletin.label}</p>
  <h2 id="week-heading">This week</h2>
  <p>
    <a class="btn btn--secondary" href={church.bulletin.file}>Download the bulletin</a>
  </p>
</section>

<style>
  .week {
    padding: var(--space-12) 0;
    max-width: 40rem;
  }

  .meta {
    margin-bottom: var(--space-4);
    color: var(--ink-soft);
  }

  h2 {
    margin-bottom: var(--space-6);
  }
</style>
