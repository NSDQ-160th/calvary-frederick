---
import { church } from '../data/church';
---

<section class="visit wrap">
  <p class="meta">I'm New</p>
  <h2>Welcome</h2>
  <p class="lead">{church.vision}</p>
  <p>
    <a class="btn btn--primary" href="/visit">Plan Your Visit</a>
  </p>
</section>

<style>
  .visit {
    padding: var(--space-16) 0;
    max-width: 42rem;
    text-align: center;
  }

  .meta {
    margin-bottom: var(--space-3);
    color: var(--ink-soft);
  }

  h2 {
    margin-bottom: var(--space-6);
  }

  .lead {
    margin-bottom: var(--space-8);
    letter-spacing: 0;
    text-transform: none;
    font-family: var(--font-ui);
  }
</style>
